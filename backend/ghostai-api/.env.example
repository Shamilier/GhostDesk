# Server configuration
PORT=8787
NODE_ENV=development

# Database
DATABASE_URL=postgres://ghostai:password@localhost:5432/ghostai

# OpenAI
OPENAI_API_KEY=sk-...

# S3 / Object storage
S3_ENDPOINT=https://ghostai.s3.eu-central-2.idrivee2.com
S3_REGION=eu-central-2
S3_BUCKET=ghostai
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_PRESIGN_EXPIRES_SEC=600
S3_FORCE_PATH_STYLE=false

# Recording limits
RECORDINGS_MAX_BYTES=209715200

# Frontend origin for CORS
PUBLIC_APP_ORIGIN=https://app.ghostai.ru
