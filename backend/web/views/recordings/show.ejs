<!DOCTYPE html>
<html lang="ru">
  <%- include('../partials/head', { title }) %>
  <body class="theme-dark">
    <div class="background-gradient"></div>
    <%- include('../partials/header', { activeNav: 'recordings' }) %>
    <main class="page recording-page">
      <section class="recording-toolbar" aria-label="Панель записи">
        <div class="player-wrap">
          <audio controls preload="metadata" src="<%= recording.audio_url || '' %>"></audio>
        </div>
        <div class="toolbar-actions">
          <% if (recording.download_url) { %>
            <a class="icon-btn" href="<%= recording.download_url %>" download title="Скачать" aria-label="Скачать запись">⬇️</a>
          <% } %>
          <button class="icon-btn" type="button" data-copy-id="<%= recording.id %>" title="Скопировать ID" aria-label="Скопировать ID">#</button>
          <form action="/recordings/<%= recording.id %>/delete" method="post" class="inline">
            <button class="icon-btn danger" type="submit" data-confirm="Удалить запись?" title="Удалить" aria-label="Удалить запись">🗑️</button>
          </form>
          <button class="icon-btn" type="button" title="Дополнительно" aria-haspopup="menu">⋯</button>
        </div>
      </section>

      <section class="recording-header">
        <div>
          <h1><%= recording.title || 'Запись' %></h1>
          <p class="muted mono">ID: <span id="rec-id"><%= recording.id %></span></p>
        </div>
        <span class="status-badge <%= (recording.status || '') %>">
          <%= recording.status_label || 'Статус' %>
        </span>
      </section>

      <section class="recording-grid">
        <div class="recording-content">
          <div class="tabs" role="tablist" aria-label="Секции записи">
            <button class="tab is-active" role="tab" aria-selected="true" data-tab="transcript">Транскрипт</button>
            <button class="tab" role="tab" aria-selected="false" data-tab="qa">Вопросы к ИИ</button>
            <button class="tab" role="tab" aria-selected="false" data-tab="notes">Заметки</button>
          </div>

          <div class="tab-panels">
            <article class="panel is-active" id="tab-transcript" role="tabpanel">
              <% if (recording.summary) { %>
                <div class="summary-callout">
                  <strong>Резюме:</strong> <%= recording.summary %>
                </div>
              <% } %>
              <% if (recording.transcript_html) { %>
                <div class="transcript-body"><%- recording.transcript_html %></div>
              <% } else { %>
                <div class="empty">
                  <p class="muted">Транскрипт появится после обработки записи.</p>
                </div>
              <% } %>
            </article>

            <article class="panel" id="tab-qa" role="tabpanel">
              <div class="empty"><p class="muted">Скоро здесь будут быстрые вопросы к ИИ.</p></div>
            </article>

            <article class="panel" id="tab-notes" role="tabpanel">
              <form action="/recordings/<%= recording.id %>/notes" method="post">
                <textarea class="notes" name="notes" placeholder="Ваши заметки…"><%= recording.notes || '' %></textarea>
                <div class="notes-actions">
                  <button class="btn primary" type="submit">Сохранить</button>
                </div>
              </form>
            </article>
          </div>
        </div>

        <aside class="recording-sidecard" aria-label="Детали записи">
          <h3>Детали</h3>
          <dl class="meta">
            <% const ts = Number(new Date(recording.started_at || 0)); const validDate = ts > 0 && !Number.isNaN(ts); %>
            <div><dt>Дата</dt><dd><%= validDate ? new Intl.DateTimeFormat('ru-RU',{day:'2-digit',month:'long',year:'numeric'}).format(ts) : '—' %></dd></div>
            <div><dt>Время</dt><dd><%= validDate ? new Intl.DateTimeFormat('ru-RU',{hour:'2-digit',minute:'2-digit'}).format(ts) : '—' %></dd></div>
            <div><dt>Длительность</dt><dd><%= recording.duration_text || '—' %></dd></div>
            <div><dt>Размер</dt><dd><%= recording.size_text || '—' %></dd></div>
            <div><dt>Статус</dt><dd><span class="status-dot <%= (recording.status||'') %>"></span> <%= recording.status_label || '—' %></dd></div>
          </dl>
        </aside>
      </section>
    </main>
    <%- include('../partials/footer') %>
    <script defer src="/recordings.js"></script>
  </body>
</html>
