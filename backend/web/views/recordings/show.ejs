<!DOCTYPE html>
<html lang="ru">
  <%- include('../partials/head', { title }) %>
  <body class="theme-dark">
    <div class="background-gradient"></div>
    <%- include('../partials/header', { activeNav: 'recordings' }) %>
    <main
      class="page recording-page"
      data-recording-page
      data-recording-id="<%= recording.id %>"
      data-recording-status="<%= recording.status %>"
    >
      <% const statusLabels = { uploaded: 'Готово', uploading: 'Загружается', failed: 'Ошибка' }; %>
      <% const statusModifiers = { uploaded: 'status-badge--success', uploading: 'status-badge--warning', failed: 'status-badge--danger' }; %>
      <% const startedAt = new Date(recording.started_at); %>

      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/recordings">Мои записи</a>
        <span aria-hidden="true">/</span>
        <span><%= helpers.formatRecordingTitle(recording) %></span>
      </nav>

      <header class="recording-header">
        <div>
          <h1><%= helpers.formatRecordingTitle(recording) %></h1>
          <p class="recording-subtitle">ID записи: <span class="recording-id"><%= recording.id %></span></p>
        </div>
        <dl class="recording-meta" role="list">
          <div class="recording-meta__item" role="listitem">
            <dt>Дата</dt>
            <dd><%= startedAt.toLocaleDateString('ru-RU', { day: '2-digit', month: 'long', year: 'numeric' }) %></dd>
          </div>
          <div class="recording-meta__item" role="listitem">
            <dt>Время</dt>
            <dd><%= startedAt.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) %></dd>
          </div>
          <div class="recording-meta__item" role="listitem">
            <dt>Длительность</dt>
            <dd><%= helpers.formatDuration(recording.duration_s) %></dd>
          </div>
          <div class="recording-meta__item" role="listitem">
            <dt>Размер</dt>
            <dd><%= helpers.formatFileSize(recording.size_bytes) %></dd>
          </div>
          <div class="recording-meta__item" role="listitem">
            <dt>Статус</dt>
            <dd>
              <span class="status-badge <%= statusModifiers[recording.status] %>">
                <span class="status-dot" aria-hidden="true"></span>
                <%= statusLabels[recording.status] %>
              </span>
            </dd>
          </div>
        </dl>
      </header>

      <section class="recording-layout">
        <div class="recording-layout__primary">
          <div class="audio-player" role="group" aria-label="Аудиоплеер записи">
            <audio controls preload="none" src="<%= playbackUrl %>" aria-label="Воспроизведение записи"></audio>
            <div class="audio-player__actions">
              <a
                class="ghost-button ghost-button--icon"
                href="<%= playbackUrl %>"
                download
                aria-label="Скачать запись"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path
                    d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <button
                type="button"
                class="ghost-button ghost-button--icon ghost-button--icon-disabled"
                aria-label="Удалить запись (скоро)"
                disabled
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path
                    d="M3 6h18M9 6V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V6m3 0v13.5A1.5 1.5 0 0 1 16.5 21h-9A1.5 1.5 0 0 1 6 19.5V6"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path d="m10 11 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </div>
          <section class="recording-summary" data-recording-summary aria-live="polite">
            <div class="recording-summary__skeleton" data-summary-skeleton>
              <% for (let i = 0; i < 4; i += 1) { %>
              <div class="recording-summary__line shimmer" aria-hidden="true"></div>
              <% } %>
            </div>
            <div class="recording-summary__content" data-summary-content hidden>
              <div class="recording-summary__header">
                <h2>Краткое резюме встречи</h2>
                <span class="recording-summary__updated" data-summary-updated hidden></span>
              </div>
              <p class="recording-summary__intro" data-summary-intro></p>
              <div class="recording-summary__grid">
                <div class="recording-summary__section" data-summary-highlights hidden>
                  <h3>Основные моменты</h3>
                  <ul data-summary-highlights-list></ul>
                </div>
                <div class="recording-summary__section" data-summary-actions hidden>
                  <h3>Следующие шаги</h3>
                  <ul data-summary-actions-list></ul>
                </div>
                <div class="recording-summary__section" data-summary-decisions hidden>
                  <h3>Принятые решения</h3>
                  <ul data-summary-decisions-list></ul>
                </div>
              </div>
            </div>
            <div class="recording-summary__empty" data-summary-empty hidden>
              <p>Резюме появится сразу после обработки записи.</p>
            </div>
          </section>
        </div>

        <div class="recording-layout__secondary" data-tabs>
          <div class="tabs" role="tablist" aria-label="Детали записи">
            <button
              class="tabs__trigger is-active"
              role="tab"
              aria-selected="true"
              aria-controls="recording-transcript"
              id="tab-transcript"
              data-tab-target="transcript"
            >
              Транскрипт
            </button>
            <button
              class="tabs__trigger"
              role="tab"
              aria-selected="false"
              aria-controls="recording-qa"
              id="tab-qa"
              data-tab-target="qa"
            >
              Вопросы к ИИ
            </button>
          </div>

          <section
            id="recording-transcript"
            class="tab-panel"
            role="tabpanel"
            aria-labelledby="tab-transcript"
            data-tab-panel="transcript"
          >
            <div class="transcript-panel" data-transcript-panel aria-live="polite">
              <div class="transcript-panel__skeleton" data-transcript-skeleton>
                <% for (let i = 0; i < 8; i += 1) { %>
                <div class="transcript-line shimmer" aria-hidden="true"></div>
                <% } %>
              </div>
              <div class="transcript-panel__content" data-transcript-content hidden>
                <div class="transcript-timeline" data-transcript-list></div>
              </div>
              <div class="transcript-panel__empty" data-transcript-empty hidden>
                <p data-transcript-empty-message>Транскрипт будет доступен позже. Мы пришлём уведомление, как только обработка завершится.</p>
              </div>
              <div class="transcript-panel__error" data-transcript-error hidden>
                <p data-transcript-error-message>Не удалось загрузить транскрипт. Попробуйте обновить страницу.</p>
              </div>
            </div>
          </section>

          <section
            id="recording-qa"
            class="tab-panel"
            role="tabpanel"
            aria-labelledby="tab-qa"
            data-tab-panel="qa"
            hidden
          >
            <div class="qa-panel" data-qa-panel>
              <div class="qa-quick-prompts" role="group" aria-label="Быстрые вопросы">
                <button type="button" class="ghost-button" data-quick-prompt>Краткое резюме</button>
                <button type="button" class="ghost-button" data-quick-prompt>Что мы обсуждали?</button>
                <button type="button" class="ghost-button" data-quick-prompt>Итоги встречи</button>
                <button type="button" class="ghost-button" data-quick-prompt>Список задач</button>
              </div>
              <div class="qa-conversation" data-qa-conversation aria-live="polite"></div>
              <form class="qa-form" data-qa-form>
                <label class="sr-only" for="qa-input">Спросить Ghost AI</label>
                <input
                  id="qa-input"
                  type="text"
                  name="prompt"
                  placeholder="Задайте вопрос Ghost AI"
                  autocomplete="off"
                  data-qa-input
                  required
                  aria-required="true"
                />
                <button type="submit" class="primary-button" data-qa-submit>
                  Отправить
                </button>
              </form>
              <p class="qa-hint">ИИ ответит, как только транскрипт будет готов. Пока доступны предварительные ответы.</p>
            </div>
          </section>
        </div>
      </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/recordings.js" defer></script>
  </body>
</html>
