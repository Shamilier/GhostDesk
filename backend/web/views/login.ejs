<!DOCTYPE html>
<html lang="ru">
  <%- include('partials/head', { title }) %>
  <body class="theme-dark auth-page">
    <div class="background-gradient"></div>
    <%- include('partials/header') %>
    <main class="page narrow">
      <section class="auth-card">
        <h1>Войти в GhostDesk</h1>
        <p class="auth-subtitle">Продолжите работу с голосовым ассистентом и историей встреч.</p>
        <%- include('partials/flash') %>
        <form action="/login" method="post" class="auth-form">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="name@company.com" required />

          <label for="password">Пароль</label>
          <div class="password-field">
            <input type="password" id="password" name="password" placeholder="Введите пароль" required />
            <button type="button" class="toggle-password" data-target="password" aria-label="Показать пароль"></button>
          </div>

          <button type="submit" class="primary-button full-width">Войти</button>
        </form>
        <p class="auth-switch">
          Нет аккаунта? <a href="/register">Зарегистрируйтесь</a>
        </p>
      </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/password-toggle.js" defer></script>
  </body>
</html>
